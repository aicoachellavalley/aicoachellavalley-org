---
import '../styles/chrome.css';
import '../styles/news.css';
import Footer from '../components/Footer.astro';

// ════════════════════════════════════════════════════════════════════════════
// Chrome for the /news/ surface ONLY. The six hand-written pages in public/
// do not use this and are not affected by anything here.
//
// The nav/footer markup and chrome.css are lifted from 404.html at 66e8000 —
// the smallest page carrying complete chrome. Only 38 CSS rules (4,865 B) are
// common to all six pages after the dead-CSS sweep, so there was no shared
// base to reuse; this is a SEVENTH copy of the chrome. Phase 1 makes the
// duplication worse, not better. Extracting one real stylesheet is the fix,
// and it belongs in a later phase because it would edit all six pages.
//
// The "News" link was propagated to all six static pages in Phase 2
// (2026-08-09), ending the temporary inconsistency Phase 1 accepted.
//
// `is-active` on News lives HERE and nowhere else: none of the six static
// pages IS /news, and the site's convention marks only the current page.
// The convention is narrow — `.nav__links a.is-active` is the ONLY rule;
// the drawer and footer have no active state anywhere on the site.
// ════════════════════════════════════════════════════════════════════════════

interface Props {
  title: string;
  description: string;
  canonical: string;
  schema?: Record<string, unknown>;
  ogType?: string;
  publishedTime?: string;
  /**
   * Which nav item is the current page. The site marks ONLY the current page,
   * so a page that is not /news must pass null — otherwise /author/sat-singh
   * would render with "News" highlighted as if it were the news index.
   * Defaults to 'news' because every existing consumer of this layout IS a
   * news page.
   */
  navActive?: 'news' | null;
  /**
   * DERIVED from `article.data.draft` — [slug].astro passes the frontmatter
   * value straight through. It is NOT a second flag to keep in step with the
   * first; a hand-maintained "noindex" boolean beside a "draft" boolean is a
   * mirror pair by another name, and flipping one without the other is exactly
   * the drift this repo keeps finding.
   *
   * WHY DRAFTS NEED IT: getStaticPaths does not filter on draft, so a draft
   * BUILDS to its own URL — it is unlisted, not unbuilt. That is deliberate:
   * the draft state exists so ported pieces can be reviewed on the new layout
   * before they are public. But 64 redirects are about to point at these URLs,
   * and the moment they do the pages stop being unlinked. Without this, "draft"
   * would mean absence from our own feeds and nothing else, and we would be
   * reviewing pages that were already being indexed.
   *
   * Because it derives, flipping `draft: false` in frontmatter removes the
   * noindex automatically. There is nothing to remember.
   *
   * Only /news/<slug> can ever be a draft; /news and /author are always
   * indexable, hence the default.
   */
  draft?: boolean;
}

const {
  title,
  description,
  canonical,
  schema,
  ogType = 'website',
  publishedTime,
  navActive = 'news',
  draft = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon — the .nav__mark treatment (volt tile, dark serif "AI"), exported
         2026-08-05. INTERIM: this is the CURRENT mark, not the AiCV/sun wordmark,
         which does not exist as artwork yet. See STATE.md. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#081C15" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Emitted only while `draft` is true; nothing at all when it is false.
        The canonical above still emits on drafts, deliberately — canonical and
        noindex together say "this page, not indexed", which is exactly the
        claim a draft should make. */}
    {draft && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AI Coachella Valley" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="alternate" type="application/rss+xml" title="AI Coachella Valley — News" href="/news/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* THREE FAMILIES on the /news surface, and exactly ONE more than the
        other six pages request. That is the whole divergence.

        BEBAS NEUE — added 2026-08-14 for the design-system pilot. Weight 400
        is the ONLY weight it has (300/500/700 all 400 from Google), and it
        carries no lowercase glyphs: lowercase input renders as caps. Titles
        only.

        DM SANS — REVERTED here from the 300..800 range back to the original
        discrete 300;400;500. ab39225 widened it so the DM Sans titles could
        reach a real 700/800 instead of synthesising; with every title now on
        Bebas, the heaviest DM Sans weight left on this surface is 500
        (.news-item__cat, .article__body h3, .author-elsewhere__label; the
        lede is 300). Nothing needs the range, so the divergence ab39225
        opened CLOSES rather than getting recorded — this line is now
        byte-identical to the other six surfaces.

        EB GARAMOND — deliberately UNCHANGED, including the 0,700 face whose
        only user (.article__title) just moved to Bebas. Trimming it would
        buy a second divergence for no measurable gain; keeping it means
        Bebas is the only difference between this request and the other six. */}
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=EB+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap"
      rel="stylesheet"
    />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>

  <body>
    <!-- ── NAV ── -->
    <nav class="nav">
      <div class="nav__inner">
        <a href="/" class="nav__logo">
          <div class="nav__mark">AI</div>
          <span class="nav__name">AI Coachella Valley</span>
        </a>
        <ul class="nav__links">
          <li><a href="/philanthropy" class="nav__cta">Philanthropy</a></li>
          <li><a href="/#programs">Programs</a></li>
          <li><a href="/events">Events</a></li>
          <li><a href="/news" class={navActive === 'news' ? 'is-active' : undefined}>News</a></li>
          <li><a href="/author/sat-singh">About</a></li>
        </ul>
        <button
          class="nav__hamburger"
          id="nav-toggle"
          aria-label="Open menu"
          onclick="this.classList.toggle('is-open');document.getElementById('nav-drawer').classList.toggle('is-open')"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <div class="nav__drawer" id="nav-drawer">
      <a
        href="/philanthropy"
        class="drawer-cta"
        onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')"
        >Philanthropy</a
      >
      <a
        href="/#programs"
        onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')"
        >Programs</a
      >
      <a
        href="/events"
        onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')"
        >Events</a
      >
      <a
        href="/news"
        onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')"
        >News</a
      >
      <a
        href="/author/sat-singh"
        onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')"
        >About</a
      >
    </div>

    <slot />

    <!-- ── FOOTER ── -->
    {/* ⚠ THE SUNSHINEFM NEWSLETTER LINK WAS REMOVED HERE, 2026-08-29, AND ITS
        ABSENCE IS A RULING — NOT A MISSING LINK TO RESTORE.

        Until this commit the Contact column on these 36 pages linked
        sunshinefm.beehiiv.com where every other surface linked /news/rss.xml.
        That was the last content difference between the seven footers, and it
        is why this file converted to the shared component last.

        FOUNDER RULING — News RSS wins everywhere:
          · SunshineFM LLC is a SEPARATE COMPANY from this property. The .org is
            a fiscally sponsored project of Desert Community Foundation; the two
            share a founder, not an entity. A newsletter link in the .org's
            footer implied a relationship that does not exist.
          · It pulled no measurable subscribers from these pages.
          · The news archive here is frozen — new writing goes to aicv.co.
        It was drift that survived because nobody had cause to look at it, not a
        decision anyone made. Do not read its absence as an oversight.

        Consequence worth knowing: the footer is now IDENTICAL on every surface
        that uses the component, so it needs no props. Adding one to bring this
        link back would make this file the only consumer that differs, which is
        the state this conversion ended. */}
    <Footer />
  </body>
</html>
