---
import Footer from '../components/Footer.astro';

// ════════════════════════════════════════════════════════════════════════════
// /pledge — converted from public/pledge.html 2026-09-01. LAST of the four
// hand-written pages to move (partner is deliberately skipped until v2; see its
// entry in src/data/site-pages.ts).
//
// ⚠⚠ THIS PAGE PRINTS ON ONE SHEET AND THAT IS THE WHOLE RISK OF TOUCHING IT.
// The @media print block at the end of the style block is THE ONLY ONE IN THE
// REPO. It ran to two pages for months before it was tuned on 2026-08-06, and
// the 8.5pt body size is load-bearing — its own comment records the measured
// alternatives. LETTER IS THE BINDING CASE (935px budget at 710px width), not
// A4 (1002).
//
// The conversion does not touch the print budget, and that was PROVED rather
// than assumed: the footer is `display: none !important` in print, so replacing
// it with a component cannot move the sheet. Measured before and after with one
// method — swap `@media print` to `@media screen` in a probe copy, load at
// 710px, take the deepest rendered element's bottom. Both readings: 888px,
// 47px of headroom. (That method reads 17px under the 905 the tuning comment
// records; the comparison is before-vs-after under ONE method, not a claim to
// reproduce their number.)
//
// ⚠ THE <style> BLOCK MUST KEEP `is:inline`, and here the stakes are higher
// than on the other conversions. Tested on a scratch build BEFORE converting:
// with `is:inline` the block passes through at 12,488 bytes — byte-identical,
// @media print intact at 3,299 chars, @page, 8.5pt and .print-attribution all
// present. WITHOUT it Astro extracts the entire block to /_astro/*.css. The
// print rules would still apply from an external sheet, but the page would stop
// carrying its own printable definition inline, and a print-layout regression
// would then be invisible in this file.
//
// ⚠ .print-attribution IS PRINT-ONLY AND CARRIES LOCKED WORDING. `display:none`
// on screen, `display:block` in print. It is the line that travels on a shared
// or pinned copy, so the fiscal-sponsorship string is the locked civic wording
// from playbook OPERATING-RULES — not a composed one. Verified rendering in the
// print probe after conversion.
//
// ⚠ NO INLINE SVG ON THIS PAGE, so the self-closing `<path/>` rewrite documented
// at the philanthropy conversion should NOT appear here. If it does, something
// other than the footer changed — stop and look.
//
// The one <script> is JSON-LD and passes through untouched; the single <button>
// and six onclick attributes are nav and drawer markup Astro does not rewrite.
// shared.css stays a <link>, not a ?raw import — same reasoning as 404.
// ════════════════════════════════════════════════════════════════════════════
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Favicon — the .nav__mark treatment (volt tile, dark serif "AI"), exported
       2026-08-05. INTERIM: this is the CURRENT mark, not the AiCV/sun wordmark,
       which does not exist as artwork yet. See STATE.md. -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#081C15">
  <title>The Responsible AI Pledge — AI Coachella Valley</title>
  <meta name="description" content="Seven principles for using AI thoughtfully, written for the Coachella Valley. Read it, sign it, and carry it forward — the full pledge, in plain language.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://aicoachellavalley.org/pledge">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=EB+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">

  <meta name="last-modified" content="2026-08-05">

  <!-- Open Graph -->
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="AI Coachella Valley">
  <meta property="og:title" content="The Responsible AI Pledge — AI Coachella Valley">
  <meta property="og:description" content="Seven principles for using AI thoughtfully, written for the Coachella Valley. Read it, sign it, and carry it forward — the full pledge, in plain language.">
  <meta property="og:url" content="https://aicoachellavalley.org/pledge">
  <meta property="og:locale" content="en_US">

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="The Responsible AI Pledge — AI Coachella Valley">
  <meta name="twitter:description" content="Seven principles for using AI thoughtfully, written for the Coachella Valley. Read it, sign it, and carry it forward — the full pledge, in plain language.">

  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": "https://aicoachellavalley.org/pledge#pledge",
  "name": "The AICV Responsible AI Pledge",
  "alternateName": "Pledge for Responsible AI",
  "headline": "Pledge for Responsible AI",
  "description": "A seven-principle commitment to using AI in ways that are human-centered, transparent, and grounded in the values of the Coachella Valley community.",
  "url": "https://aicoachellavalley.org/pledge",
  "inLanguage": "en",
  "datePublished": "2026-06-27",
  "dateModified": "2026-08-05",
  "isPartOf": {
    "@id": "https://aicoachellavalley.org/#website"
  },
  "author": {
    "@id": "https://aicoachellavalley.org/#organization"
  },
  "publisher": {
    "@id": "https://aicoachellavalley.org/#organization"
  },
  "about": {
    "@id": "https://aicoachellavalley.org/#organization"
  },
  "license": "https://aicoachellavalley.org/pledge",
  "abstract": "AI is part of everyday life — in school, work, and creativity. This pledge is not rules handed down to you. It’s the values you choose when you use powerful tools. Here are seven principles for using this technology thoughtfully. Powerful tools require thoughtful people.",
  "hasPart": {
    "@type": "ItemList",
    "name": "The seven principles",
    "numberOfItems": 7,
    "itemListOrder": "https://schema.org/ItemListOrderAscending",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "CreativeWork",
          "name": "People Lead, AI Follows",
          "description": "You are always the author. Use AI to expand what you can do — not to replace your thinking, your judgment, or your voice. If you stop questioning what AI gives you, you’re letting it make decisions for you."
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "CreativeWork",
          "name": "Be Honest About What’s AI",
          "description": "If AI made it, say so. A voice, an image, a recommendation — don’t present AI-generated work as purely your own. Trust between people is fragile and hard to rebuild. Protect it like it matters, because it does."
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@type": "CreativeWork",
          "name": "Guard What’s Private",
          "description": "Before you share, pause. Personal information deserves more protection than most people give it. If something feels like more than you should be sharing, trust that instinct. Share less than you think you need to. Protect more than you think you have to."
        }
      },
      {
        "@type": "ListItem",
        "position": 4,
        "item": {
          "@type": "CreativeWork",
          "name": "Watch for What’s Unfair",
          "description": "AI learns from the past — and the past wasn’t always fair. Bias gets built into algorithms quietly, showing up in who gets flagged, recommended, or left out. Stay curious. Ask questions. Make sure the tools you use treat everyone the same way."
        }
      },
      {
        "@type": "ListItem",
        "position": 5,
        "item": {
          "@type": "CreativeWork",
          "name": "Think About Real People",
          "description": "Whether you’re creating with AI or just using it, what you put out affects real people — your neighbors, your community, your family. Before you post, share, or publish, ask: does this actually help? Or does it just add more noise?"
        }
      },
      {
        "@type": "ListItem",
        "position": 6,
        "item": {
          "@type": "CreativeWork",
          "name": "Share What You Learn",
          "description": "Nobody has AI figured out. We’re all discovering its strengths, limits, and risks in real time. Share what you find — the wins, the surprises, the things that didn’t work. Those experiences help all of us grow wiser together."
        }
      },
      {
        "@type": "ListItem",
        "position": 7,
        "item": {
          "@type": "CreativeWork",
          "name": "Stay Human",
          "description": "AI can be a collaborator and sounding board — but it cannot be you. It doesn’t know you; it reflects you. Real connection, real friendship, real belonging still come from other people. Use AI to expand your humanity, not to replace it."
        }
      }
    ]
  }
}
  </script>
    <!-- SITE CHROME — reset, nav, footer, tokens. ONE source: public/styles/shared.css.
       These four pages are hand-written HTML shipped byte-for-byte and can import
       nothing, so they LINK it. They already link Google Fonts, so this is not a new
       mechanism, and none of them is the landing page. Page-specific CSS stays inline
       below. Gate 6 fails the build if this page re-declares anything shared. -->
  <link rel="stylesheet" href="/styles/shared.css">
  <style is:inline>
    /* ════════════════════════════════════════
       DESIGN TOKENS — single source of truth
    ════════════════════════════════════════ */:root {
      --fs-pull: clamp(20px, 2.6vw, 30px);
    }

    /* ════════════════════════════════════════
       LAYOUT UTILITIES
    ════════════════════════════════════════ */
    .wrap {
      max-width: var(--max-w);
      margin: 0 auto;
    }

    .section {
      padding: var(--s-5) var(--gutter);
    }

    /* ════════════════════════════════════════
       TYPOGRAPHY UTILITIES
    ════════════════════════════════════════ */
    .eyebrow {
      display: block;
      font-size: var(--fs-10);
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--c-accent-text);
      margin-bottom: var(--s-1);
    }

    .h2 {
      font-size: var(--fs-h2);
      color: var(--c-text);
      margin-bottom: var(--s-2);
    }
    .nav__links a.is-active { color: var(--c-on-ground-hi); font-weight: 500; }
    .nav__cta {
      background: transparent !important;
      color: var(--c-on-ground-hi) !important;
      border: 1px solid var(--c-on-ground-hi) !important;
      padding: 6px 15px !important;   /* -1px absorbs the border: outer box unchanged */
      font-weight: 500 !important;
    }
    .nav__cta:hover { background: var(--c-accent-fill) !important; color: var(--c-text) !important; }
    .nav__drawer .drawer-cta {
      margin-top: 16px;
      background: var(--c-accent-fill);
      color: var(--c-text) !important;
      text-align: center;
      padding: 13px !important;
      border: none !important;
      font-weight: 500;
    }

    /* ════════════════════════════════════════
       HERO
    ════════════════════════════════════════ */
    .hero {
      background: var(--c-ground);
      padding: 56px var(--gutter) 44px;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background-image: repeating-linear-gradient(
        -45deg,
        transparent, transparent 40px,
        rgba(255,255,255,0.011) 40px, rgba(255,255,255,0.011) 41px
      );
      pointer-events: none;
    }@keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .hero .eyebrow   { animation: fadeUp 0.55s ease both 0.1s; }
    .hero .h1        { animation: fadeUp 0.55s ease both 0.2s; }

    /* ════════════════════════════════════════
       HERO — CREAM VARIANT
    ════════════════════════════════════════ */
    .hero--cream {
      background: var(--c-paper);
      border-bottom: 1px solid var(--c-border);
    }
    .hero--cream::before         { display: none; }
    .hero--cream .h1             { color: var(--c-text); }
    .hero--cream .eyebrow        { color: var(--c-accent-text); opacity: 1; }
    .footer__desc {
      font-size: var(--fs-12);
      font-weight: 300;
      color: var(--c-on-ground-m);
      line-height: 1.7;
    }
    .footer__col-label {
      font-size: var(--fs-10);
      font-weight: 500;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--c-on-ground-m);
      margin-bottom: var(--s-2);
    }


    /* ─── THE PLEDGE ───────────────────────────────────────────────────
       The page IS the pledge. There is no PDF and no form: the print
       stylesheet at the bottom of this block turns it into the signable
       artifact, which is why the signature lines are real markup and not
       decoration. Copy is verbatim from the published document — do not
       edit it here without editing the document. */
    .pledge-wrap { max-width: 760px; }

    .pledge-preamble {
      font-family: 'EB Garamond', Georgia, serif;
      font-size: var(--fs-pull);
      font-style: italic;
      font-weight: 400;
      line-height: 1.45;
      color: var(--c-text);
      /* --s-7 does not exist — the scale is 1,2,3,4,5,6,8,10,14. The whole
         shorthand was therefore invalid at computed-value time and dropped,
         so margin-bottom silently computed to 0 and the gap under the rule
         came from nothing. --s-6 rather than --s-8 because every internal
         hairline on this page already has 48px on BOTH sides: .principle
         carries padding: var(--s-6) 0, so consecutive principles sit 48
         above and 48 below their shared rule. This rule had 48 above and 0
         below; --s-6 restores that symmetry instead of inventing a value.
         --s-8 is already doing real work as the last-principle-to-sign
         break, and using it here would make this rule uniquely looser than
         the seven beneath it. Fixed 2026-08-06. */
      margin: 0 0 var(--s-6);
      padding-bottom: var(--s-6);
      border-bottom: 1px solid var(--c-border);
    }
    /* The thesis line. Carries the most weight on the page after the h1. */
    .pledge-preamble__close {
      display: block;
      margin-top: var(--s-4);
      font-style: normal;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    /* Principles. The numeral is a display element but it carries meaning —
       it is the principle's number — so it uses accent-text-d (6.11:1 on
       paper), not the ghost tint used for decorative watermarks. */
    .principles { margin-top: 0; }
    .principle {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 0 var(--s-4);
      padding: var(--s-6) 0;
      border-top: 1px solid var(--c-border);
    }
    .principle:first-child { border-top: 0; padding-top: 0; }
    /* Volt tile, pine numeral — the same treatment as .nav__mark and the
       favicon, so the page carries the brand mark rather than borrowing a
       one-off. Doctrine (BRAND.md §1): volt #D8FF00 is ~1.1:1 on any light
       surface, so it is a FILL behind dark text and never text itself.
       Pine on volt measures 9.61:1. */
    .principle__num {
      width: 64px;
      height: 64px;
      background: var(--c-accent-fill);
      color: var(--c-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 26px;
      font-weight: 700;
      line-height: 1;
      font-variant-numeric: lining-nums tabular-nums;
    }
    .principle__title {
      font-family: 'EB Garamond', Georgia, serif;
      font-size: var(--fs-22);
      font-weight: 600;
      color: var(--c-text);
      margin: 0 0 var(--s-2);
      line-height: 1.25;
    }
    .principle__body {
      font-size: var(--fs-15);
      font-weight: 300;
      color: var(--c-text);
      line-height: 1.75;
      margin: 0;
      max-width: 62ch;
    }

    /* Signing block — real markup so it prints. */
    .pledge-sign { margin-top: var(--s-8); }
    .pledge-sign__intro {
      font-size: var(--fs-15);
      font-weight: 300;
      color: var(--c-text);
      line-height: 1.75;
      margin: 0 0 var(--s-5);
    }
    .sign-lines {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: var(--s-5);
      margin-top: var(--s-5);
    }
    .sign-line { border-bottom: 1px solid var(--c-text); padding-bottom: 6px; }
    .sign-line__label {
      display: block;
      margin-top: 44px;
      font-size: var(--fs-10);
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--c-text-l);
    }
    .pledge-print-hint {
      margin-top: var(--s-4);
      font-size: var(--fs-13);
      font-weight: 300;
      color: var(--c-text-l);
    }

    /* Closing lines — both load-bearing copy. */
    .pledge-mantra {
      margin-top: var(--s-8);
      font-family: 'EB Garamond', Georgia, serif;
      font-size: clamp(24px, 3.2vw, 38px);
      font-weight: 700;
      color: var(--c-text);
      letter-spacing: -0.01em;
    }
    .pledge-mantra span { margin-right: 0.75em; }
    .pledge-final {
      margin-top: var(--s-4);
      font-family: 'EB Garamond', Georgia, serif;
      font-size: clamp(19px, 2.4vw, 26px);
      font-style: italic;
      color: var(--c-text);
      line-height: 1.4;
    }

    .pledge-workshop {
      margin-top: var(--s-8);
      padding-top: var(--s-5);
      border-top: 1px solid var(--c-border);
      font-size: var(--fs-15);
      font-weight: 300;
      color: var(--c-text);
      line-height: 1.75;
      max-width: 62ch;
    }
    .pledge-workshop a { color: var(--c-accent-text-d); }

    /* Web-only source line. Deliberately quieter than .pledge-workshop: this is
       attribution, not an offer. Hidden in print — see the @media print block. */
    .pledge-sources {
      margin-top: var(--s-3);
      font-size: var(--fs-12);
      font-weight: 300;
      color: var(--c-text-l);
      line-height: 1.6;
      max-width: 62ch;
    }

    /* Print-only attribution. Hidden on screen; this is the line that
       travels on a shared or pinned copy, so the fiscal-sponsorship
       string is the locked civic wording from playbook OPERATING-RULES,
       not a composed one. */
    .print-attribution { display: none; }@media (max-width: 640px) {
      .principle { grid-template-columns: 48px 1fr; gap: 0 var(--s-3); }
      .principle__num { width: 48px; height: 48px; font-size: 20px; }
      .sign-lines { grid-template-columns: 1fr; }
    }

    /* ─── PRINT: the signable artifact ───────────────────────────────
       Replaces the PDF. Strips the nav, drawer, site footer and the
       workshop line, and prints the preamble, seven principles and the
       signature lines on plain paper. */@media print {
      @page { margin: 16mm 14mm; }
      html, body { background: #fff !important; }
      .nav, .nav__drawer, .footer, .pledge-workshop, .pledge-sources, .pledge-print-hint { display: none !important; }
      .hero, .section { padding: 0 !important; min-height: 0 !important; background: #fff !important; }
      .hero::before { display: none !important; }
      .wrap, .pledge-wrap { max-width: 100% !important; }
      * { color: #000 !important; }
      /* No volt on paper: the tile becomes plain type. Background printing is
         off by default in most browsers anyway, which would have left pine on
         white with the tile's centring still applied. */
      .principle__num {
        background: transparent !important;
        color: #000 !important;
        width: auto; height: auto;
        display: block;
        font-size: 20pt;
        font-weight: 700;
      }
      /* ── ONE PAGE. Retuned 2026-08-06 because it never was. ──────────
         At true printable width the sheet measured 1291px against 935
         (Letter) and 1002 (A4) — it always ran to a second page, while the
         on-screen hint claimed it "lays out clean on one sheet". Now 905px
         on Letter and 921px on A4, clearing both.

         WHAT THE SMALLER BODY BUYS: at 10pt every body ran to 3 lines. At
         8.5pt all seven run to 2, so the items are visually even AND the
         padding between them stays generous. Measured alternatives: 9pt
         bodies fit only with padding down at 4pt (11px between principles,
         three bodies still at 3 lines); 8.5pt at 9pt padding overflows
         Letter by 2px. Half a point of type buys the separation.

         LETTER IS THE BINDING CONSTRAINT, not A4 — 935 vs 1002. Anything
         added here must be re-measured against 935 at 710px width. An
         iframe's own height measures nothing. */
      .principle {
        break-inside: avoid; page-break-inside: avoid;
        padding: 8pt 0; border-top: 0.5pt solid #999;
        grid-template-columns: 40px 1fr; gap: 0 9pt;
      }
      .principle__body { font-size: 8.5pt; line-height: 1.4; max-width: 100%; }
      .principle__title { font-size: 11pt; margin-bottom: 2pt; }
      .pledge-preamble {
        font-size: 10.5pt; line-height: 1.3;
        /* the screen rule's var(--s-6) is 48px — far too loose on paper */
        margin-bottom: 7pt; padding-bottom: 7pt;
      }
      .pledge-preamble__close { margin-top: 3pt; }
      .principles { margin-top: 6pt; }
      .pledge-sign { margin-top: 10pt; break-inside: avoid; page-break-inside: avoid; }
      .pledge-sign .h2 { font-size: 14pt; }
      .pledge-sign__intro { font-size: 8.5pt; margin-bottom: 5pt; }
      .sign-line { border-bottom: 0.5pt solid #000; }
      .sign-line__label { margin-top: 18pt; font-size: 7pt; }
      .pledge-mantra { margin-top: 8pt; font-size: 11.5pt; }
      .pledge-final { margin-top: 3pt; font-size: 9.5pt; }
      .print-attribution {
        display: block;
        margin-top: 6pt;
        padding-top: 5pt;
        border-top: 0.5pt solid #999;
        font-size: 7.5pt;
        line-height: 1.5;
        color: #000 !important;
      }
      .h1 { font-size: 14pt !important; }
      .eyebrow { font-size: 7pt !important; }
      a { text-decoration: none !important; }
    }</style>
</head>
<body>

<!-- ── NAV ── -->
<nav class="nav">
  <div class="nav__inner">
    <a href="/" class="nav__logo">
      <div class="nav__mark">AI</div>
      <span class="nav__name">AI Coachella Valley</span>
    </a>
    <ul class="nav__links">
      <li><a href="/philanthropy" class="nav__cta">Philanthropy</a></li>
      <li><a href="/#programs">Programs</a></li>
      <li><a href="/events">Events</a></li>
      <li><a href="/news">News</a></li>
      <li><a href="/author/sat-singh">About</a></li>
    </ul>
    <button class="nav__hamburger" id="nav-toggle" aria-label="Open menu" onclick="this.classList.toggle('is-open');document.getElementById('nav-drawer').classList.toggle('is-open')">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="nav__drawer" id="nav-drawer">
