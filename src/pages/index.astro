<!-- ── HERO ── -->
<section class="hero">
  <picture class="hero__media">
    <source media="(max-width: 700px)" type="image/webp" srcset="/hero-sunrise-960.webp">
    <source media="(max-width: 700px)" srcset="/hero-sunrise-960.jpg">
