    /* ════════════════════════════════════════
       BUTTONS
    ════════════════════════════════════════ */
    .btn {
      display: inline-block;
      font-family: 'DM Sans', sans-serif;
      font-size: var(--fs-13);
      font-weight: 500;
      letter-spacing: 0.03em;
      text-decoration: none;
      padding: 13px 28px;
      border: none;
      cursor: pointer;
      transition: background 0.15s, transform 0.1s, border-color 0.15s, color 0.15s;
      line-height: 1;
    }
    .btn:hover { transform: translateY(-1px); }

    .btn--primary { background: var(--c-accent-fill); color: var(--c-text); }
    .btn--primary:hover { background: var(--c-accent-fill-h); }
    .nav__cta {
      background: transparent !important;
      color: var(--c-on-ground-hi) !important;
      border: 1px solid var(--c-on-ground-hi) !important;
      padding: 6px 15px !important;   /* -1px absorbs the border: outer box unchanged */
      font-weight: 500 !important;
    }
    .nav__cta:hover { background: var(--c-accent-fill) !important; color: var(--c-text) !important; }
    /* ── HERO — photograph, index only (2026-08-05) ──────────────────
       The other four pages use .hero--cream and are untouched.
       The dark-hero treatment is GONE and deliberately so:
         · .hero::before was a 1.1%-white diagonal scanline — texture for a
           flat dark field. Invisible over a photograph. REPURPOSED as the
           scrim below rather than left as dead weight.
         · .hero__ghost was a 380px "AI" at 2.5% white, bottom-right. Over
           a photo it is invisible, redundant (the image now carries the
           interest) and sat exactly where the sun blows out. REMOVED.
       Fallback is LIGHT so a slow image never flashes dark behind dark type. */
    .hero {
      background: var(--c-surface);
      padding: 120px var(--gutter) 56px;
      min-height: clamp(380px, 40vw, 560px);
      position: relative;
      overflow: hidden;
    }
    .hero__media {
      position: absolute; inset: 0; z-index: 0;
    }
    .hero__media img {
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: 50% 58%;
      display: block;
    }
    /* Scrim. Measured, not guessed: pine on the raw haze is 5.03:1 at the mean
       but 4.25:1 against the darkest 2nd percentile — under AA. Paper from the
       left lifts the type region clear while leaving the right of the frame,
       and the sun, fully open. */
    .hero::before {
      content: '';
      position: absolute; inset: 0; z-index: 1;
      /* Stops placed against MEASURED type extents, not by eye. At 1280 the h1's
         longest line reaches 57% of hero width and the accent 53.8%; everything
         right of 57% is type-free, yet the old chain did not clear until 86% —
         14 points of frame dimmed for no contrast reason. The 0.72 stop sits at
         34% because the accent is the binding element (3:1 large text) and its
         alpha is set there, NOT by the left stop: sweeping the left stop from
         0.74 to 0.60 never moves the tightest margin. 0.70 is chosen for looks.
         RE-DERIVED 2026-08-05 when the headline gained "Building": the first
         line went from reaching 57% of hero width to 76%, running straight past
         the 72% clear point and collapsing the h1 margin to +0.10 at 1024.
         Stops pushed out to 0.48@66 / 0@82 to cover the longer line (+0.82).
         STANDING LESSON: this gradient is derived from where the type ends.
         Any copy edit to the h1 invalidates it — re-measure, do not assume. */
      background: linear-gradient(to right,
        rgba(var(--c-paper-rgb),0.70) 0%,
        rgba(var(--c-paper-rgb),0.72) 34%,
        rgba(var(--c-paper-rgb),0.48) 66%,
        rgba(var(--c-paper-rgb),0) 82%);
      pointer-events: none;
    }
    /* Type inverts: this hero is now LIGHT. */
    .hero .h1 { color: var(--c-text); }
    /* ⚠ VOLT WAS TRIED HERE AND REVERTED — 2026-08-27. Ruled, not merely
       undone: pine-light is the value, and volt is not a candidate for this
       element as the hero is composed today.

       WHAT HAPPENED: --c-on-ground-hi (volt, #D8FF00) was set on this rule,
       built, and looked at. It disappears. The accent sits on the BRIGHT LEFT
       SIDE of the hero photograph, under the paper scrim, which runs about 0.70
       alpha across that band — a near-white ground. Measured beforehand at
       1.08:1 to 1.11:1 composited, and 1.75:1 to 1.95:1 against the bare image
       with no scrim; the eye agrees with the number. This is exactly what
       BRAND.md §1 says, recorded in shared.css: volt is a FILL, NEVER TEXT ON
       LIGHT.

       THE QUESTION IS NOT CLOSED FOREVER, ONLY FOR THIS COMPOSITION. What kills
       it is WHERE the accent sits, not the colour itself. The right side of the
       same photograph is dark mountain, and volt on dark is the case that token
       is built for — it measures 15.35:1 on the ground colour. So a crop change,
       a re-cropped or replaced hero image, or a layout change that moves the
       headline right can make volt viable here. Re-measure against the pixels
       actually behind the type before assuming either way; do not treat this
       note as a permanent ban on the colour.

       Related and separate: font-style was removed from .h1 .accent above. That
       was a real defect, not a look — Bebas Neue has no italic and none is
       requested, so it obliqued the roman. It stays removed. */
    .hero .h1 .accent { color: var(--c-accent-text-d); }

    /* MOBILE — the desktop scrim runs left-to-right because the type sits left.
       On mobile the type spans the full width, so a horizontal scrim cannot
       protect it: measured, the headline's last line ran straight into the palm
       silhouettes at rgb(67,60,12) — pine on that is 1.00:1, invisible.
       Two changes: a taller hero drops the palm line BELOW the type, and the
       scrim turns vertical so it covers the type band and clears for the palms.
       Placed immediately after the base rules it overrides — the source-order
       cascade trap this file has hit three times. */

    /* ── NEWS (homepage) — added 2026-08-09, Phase 2 ──────────────────────
       Mirrors .prog-grid / .prog-card so the section reads as part of the
       page, with ONE difference: auto-fit instead of repeat(3, 1fr), so the
       grid is not broken by 1 or 2 articles. With one article the card fills
       the row; with two, halves; with three, thirds. */
    .news-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
      gap: 2px;
      background: var(--c-border);
      border: 2px solid var(--c-border);
    }
    .news-card {
      background: var(--c-paper);
      padding: 26px 24px;
      display: flex;
      flex-direction: column;
      /* No min-height on purpose. Grid items stretch to the tallest card in the
         row automatically, so multi-card rows still align — while a SINGLE card
         stays compact instead of sitting above ~80px of dead space. */
      text-decoration: none;
    }
    .news-card:hover .news-card__title { color: var(--c-accent-text); text-decoration: underline; text-underline-offset: 3px; }
    .news-card__date {
      font-size: var(--fs-10);
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--c-text-l);
      margin-bottom: 10px;
    }
    /* ⚠ BEBAS — THE TEXT *IS* THE THING. This is not a component label; it is the
       ARTICLE TITLE at card size. Rendered in EB Garamond it changed typeface the
       moment you clicked through to the article, which reads as a bug: same
       content, same face, every surface it appears on.

       THE RULE THAT DECIDES THIS, and it is sharper than "structure vs component":
       BEBAS WHERE THE TEXT *IS* THE THING. EB GARAMOND WHERE THE TEXT *LABELS*
       SOMETHING ELSE. An article title is the article. A .series__name over a
       session list, a .prog-title over a program card, a .principle__title
       over its principle — those name a thing sitting next to them, and they keep
       the serif. Both this reversal and the .series__name revert fall out of it.

       ⚠ NO BACKTICKS IN THIS BLOCK — EVER. Since pass 1 this CSS lives inside a JS
       template literal (set:html={sharedCss + ...}), so a backtick ANYWHERE in it,
       including inside a CSS comment, terminates the string. This very comment did
       exactly that: the build died with '.series__name is not a function'.

       Article titles now agree on all four surfaces that render one:
       /news .news-item__title, /news/<slug> .article__title,
       /author/sat-singh .news-item__title, and this card. */
    .news-card__title {
      font-family: 'Bebas Neue', Impact, sans-serif;
      font-size: var(--fs-22);
      font-weight: 400;
      color: var(--c-text);
      line-height: 1.2;
      margin: 0 0 10px;
    }
    .news-card__body {
      font-size: 13px;
      font-weight: 300;
      color: var(--c-text);
      line-height: 1.65;
      flex: 1;
      margin: 0;
    }
    .news-card__more {
      margin-top: 16px;
      font-size: var(--fs-12);
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--c-accent-text);
    }
    .news-all {
      display: inline-block;
      margin-top: 24px;
      font-size: var(--fs-13);
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--c-accent-text);
      text-decoration: none;
    }
    .news-all:hover { text-decoration: underline; text-underline-offset: 3px; }@media (max-width: 700px) {
      .hero { min-height: 460px; }
      .hero::before {
        /* Re-derived for a hero with NO band beneath the type. The chain shipped
           in 2f4947e (0.88/0.66@36/0.36@55/0@100) CANNOT be kept here: it cleared
           from 55% down because the band covered everything below that. With the
           band gone the hero pins to min-height 460 and the type runs to 74.9% at
           375 and 78.6% at 320, so the accent's last line landed on 0.17-0.20
           alpha — measured 2.33 against a 3:1 threshold at 320. Three breakpoints
           failed (430/375/320).
           So the fall-off is pushed below the type: 0.70 is held to 72% and the
           clear happens in the bottom eighth. Worst margin +0.68 at 320.
           Photo visible 43.8% of the hero, vs 31.8% for the pre-band chain — the
           reveal survives the revert, it just has less room to work in. */
        background: linear-gradient(to bottom,
          rgba(var(--c-paper-rgb),0.88) 0%,
          rgba(var(--c-paper-rgb),0.80) 40%,
          rgba(var(--c-paper-rgb),0.70) 72%,
          rgba(var(--c-paper-rgb),0.28) 88%,
          rgba(var(--c-paper-rgb),0) 100%);
      }
      .hero__media img { object-position: 50% 72%; }
    }
    .hero__headline {
      margin-bottom: 0;
    }
    /* hero fade-in */@keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    /* index is the only page with a DARK hero (the others use .hero--cream),
       so its eyebrow is the one plain .eyebrow sitting on the ground. Pine
       would be 1.60:1 here. Scoped, not global — .eyebrow on light pages must
       stay --c-accent-text. */
    .hero .eyebrow   { animation: fadeUp 0.55s ease both 0.1s; }  /* colour inherits .eyebrow = pine */
    .hero__headline  { animation: fadeUp 0.55s ease both 0.2s; }
    .nav__drawer .drawer-cta {
      margin-top: 16px;
      background: var(--c-accent-fill);
      color: var(--c-text) !important;
      text-align: center;
      padding: 13px !important;
      border: none !important;
      font-weight: 500;
    }

    /* ════════════════════════════════════════
       STATS
    ════════════════════════════════════════ */
    /* Slimmed 2026-08-12. This padding framed a four-cell grid; the band is
       now a single affiliation line and the old spacing left it floating in
       an empty dark block. */
    .stats {
      background: var(--c-ground);
      padding: var(--s-5) var(--gutter);
    }
    .stats__affil {
      text-align: center;
      font-size: var(--fs-12);
      color: var(--c-on-ground-m);
      max-width: var(--max-w);
      margin-left: auto;
      margin-right: auto;
    }
    .stats__affil strong { color: var(--c-on-ground); font-weight: 500; }

    /* ════════════════════════════════════════
       PROGRAMS
    ════════════════════════════════════════ */
    .programs-intro {
      max-width: 560px;
      margin-bottom: var(--s-6);
    }
    .prog-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
      background: var(--c-border);
      border: 2px solid var(--c-border);
    }
    .prog-card {
      background: var(--c-paper);
      padding: 28px 24px;
      display: flex;
      flex-direction: column;
      min-height: 300px;
      position: relative;
      overflow: hidden;
    }
    .prog-card--featured { background: var(--c-surface-d); }

    /* ⚠ BEBAS, NOT EB GARAMOND — RULED 2026-08-26. EB Garamond is reserved for
       BRAND MARKS ONLY: .nav__mark, .footer__name, .footer__tagline. It is not
       card typography. A later pass that finds Bebas here and "restores
       consistency" by putting the serif back is reversing a decision, not
       fixing a drift. The three rules below — .prog-num, .prog-title,
       .prog-tagline — are the whole of that ruling on this page.

       font-weight 400, NOT the 700 these carried: Bebas Neue is a SINGLE-WEIGHT
       face and the fonts.googleapis.com request asks for no weight axis, so 700
       renders as a synthesised faux-bold. 400 is the value h1,h2,h3 and
       .news-card__title already use. */
    .prog-num {
      position: absolute;
      bottom: -6px; right: 14px;
      font-family: 'Bebas Neue', Impact, sans-serif;
      font-size: 88px; font-weight: 400;
      color: var(--c-border);
      line-height: 1;
      pointer-events: none;
      user-select: none;
    }
    .prog-card--featured .prog-num { color: rgba(var(--c-accent-on-fill-rgb),0.28); }

    .prog-title {
      font-family: 'Bebas Neue', Impact, sans-serif;
      font-size: var(--fs-22);
      font-weight: 400;
      color: var(--c-text);
      line-height: 1.2;
      margin-bottom: 10px;
      position: relative; z-index: 1;
    }
    .prog-card--featured .prog-title { color: var(--c-text); }

    /* THE ITALIC IS REAL — FIXED 2026-08-27. This comment used to record the
       opposite, and the fix it asked for has now been made: the DM Sans family
       in the fonts.googleapis.com link gained an ital axis, so a genuine italic
       face is fetched and the browser no longer obliques the roman.

       AXES ARE ALPHABETICAL — ital, opsz, wght — which is what Google's own
       generator emits, and every tuple therefore carries a leading 0 or 1. That
       reordering is why this could not be a one-token append. Google will also
       serve a WRONG axis order without complaint (opsz,wght,ital returns 200 and
       valid italic CSS), so a malformed request does not announce itself; keep
       the order alphabetical rather than trusting the response.

       ONLY 1,9..40,400 is requested, not the full italic set. .prog-tagline is
       the sole DM Sans italic consumer on any of the seven surfaces and it
       resolves at weight 400 — asking for 300 and 500 italic too would request
       two faces nothing uses.

       (No backticks in this comment on purpose: this whole style block is a
       template literal on set:html, so one backtick here ends it and the build
       dies in esbuild with a message that points at CSS, not at the quote.) */
    .prog-tagline {
      font-family: 'DM Sans', sans-serif;
      font-style: italic;
      font-size: 14px;
      color: var(--c-text-l);
      margin: 0 0 16px 0;
      line-height: 1.4;
      position: relative; z-index: 1;
    }
    .prog-card--featured .prog-tagline { color: var(--c-text); }

    .prog-shot {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      object-position: top;
      border-radius: 4px;
      margin: 0 0 16px 0;
      position: relative; z-index: 1;
    }

    .prog-body {
      font-size: 13px;
      font-weight: 300;
      color: var(--c-text);
      line-height: 1.65;
      flex: 1;
      position: relative; z-index: 1;
    }
    .prog-card--featured .prog-body { color: rgba(var(--c-text-rgb),0.8); }

    .prog-tag {
      display: inline-block;
      margin-top: var(--s-3);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--c-accent-text);
      background: var(--c-border-l);
      padding: 5px 10px;
      position: relative; z-index: 1;
      align-self: flex-start;
    }
    .prog-card--featured .prog-tag {
      background: var(--c-accent-fill);
      color: var(--c-accent-text);
    }
    a.prog-tag { text-decoration: none; }
    a.prog-tag:hover { opacity: 0.8; }
    .prog-card--featured a.prog-tag:hover { opacity: 0.85; }

    /* ─── PROGRAM STATUS PILLS + DIMMED STATE ─── */
    .prog-pill {
      display: inline-block;
      padding: 4px 10px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      border-radius: 999px;
      margin-bottom: var(--s-3);
      position: relative; z-index: 1;
    }
    .prog-pill.pill-live {
      background: var(--c-paper);
      color: var(--c-accent-text);
    }
    /* right col */
    .pledge-copy {
      /* Was measured by the two-column .pledge-layout grid, removed 2026-08-05
         with the deck thumbnail and the lightbox. Carries its own measure now. */
      max-width: 62ch;
      font-size: var(--fs-15);
      font-weight: 300;
      color: rgba(var(--c-paper-rgb),0.58);
      line-height: 1.75;
    }
    .pledge-copy + .pledge-copy { margin-top: var(--s-2); }
    .pledge-cta { margin-top: var(--s-4); }

    /* full-width closer */

    /* ════════════════════════════════════════
       FOUNDER
    ════════════════════════════════════════ */
    .founder-layout {
      display: grid;
      grid-template-columns: 290px 1fr;
      gap: var(--s-10);
      align-items: start;
    }
    /* 168px, not the 290px original: the photo is now a credential beside three
       lines rather than a portrait beside four paragraphs. Same aspect ratio and
       same volt caption; only the column narrows. Copy pass 2026-08-17.
       ⚠ MUST STAY AFTER .founder-layout. Same specificity (0,1,0), so SOURCE
       ORDER decides — placed above the base rule it lost silently and the
       column stayed 290px. The build was green and the DOM assertion caught
       it, not the compiler. This is the source-order trap HANDOFF.md warns
       about, hit a fourth time. */
    .founder-layout--compact { grid-template-columns: 168px 1fr; }

    .founder-img-wrap { position: relative; }
    .founder-img {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      filter: grayscale(12%);
    }
    .founder-credential {
      position: absolute; bottom: 0; left: 0; right: 0;
      background: var(--c-accent-fill);
      padding: 9px 14px;
      font-size: var(--fs-10);
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--c-text);
    }
    .founder-bio {
      /* Was measured by the two-column .founder-layout grid, whose classes were
         dropped 2026-08-27 with the photo. Carries its own measure now — the
         same sentence, and the same 62ch, as .pledge-copy, which lost its grid
         the same way in 2026-08-05. Identical type here and there (--fs-15,
         weight 300, line-height 1.75), so the two measures should stay equal. */
      max-width: 62ch;
      font-size: var(--fs-15);
      font-weight: 300;
      color: var(--c-text);
      line-height: 1.75;
      margin-bottom: var(--s-2);
    }
    .founder-bio a { color: var(--c-accent-text); text-decoration: none; }
    .founder-bio a:hover { text-decoration: underline; }
    .founder-sig {
      margin-top: var(--s-3);
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 17px;
      font-style: italic;
      color: var(--c-accent-text);
    }
    .founder-sig strong {
      display: block;
      font-family: 'DM Sans', sans-serif;
      font-style: normal;
      font-weight: 600;
      font-size: var(--fs-13);
      color: var(--c-text);
      margin-top: 3px;
    }
    .founder-sig span {
      font-weight: 300;
      color: var(--c-text-l);
    }
    .footer__desc {
      font-size: var(--fs-12);
      font-weight: 300;
      color: var(--c-on-ground-m);
      line-height: 1.65;
      max-width: 240px;
    }
    .footer__col-label {
      font-size: var(--fs-10);
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--c-on-ground-m);
      margin-bottom: 16px;
    }@media (max-width: 640px) {
      .prog-grid     { grid-template-columns: 1fr; }
      .founder-layout { grid-template-columns: 1fr; }
      .founder-img-wrap { max-width: 220px; }
    }

    /* ─── PARTNER GROUPS (ported from ai-readiness) ─── */
    .partner-group__label {
      font-size: var(--fs-10);
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--c-accent-text);
      margin-bottom: var(--s-1);
    }
    .partner-group__list {
      font-size: var(--fs-15);
      font-weight: 300;
      color: var(--c-text);
      line-height: 1.75;
    }
    .partners-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2px;
      margin-top: var(--s-5);
      background: var(--c-border);
      border: 2px solid var(--c-border);
    }
    .partner-card {
      background: var(--c-paper);
      padding: 30px 26px;
    }
    /* THREE GROUPS IN A TWO-COLUMN GRID. Card 1 spans both rows so column two
       can stack the other two. Without the span the three cards flow 1/2/3 and
       leave cell 4 EMPTY — and an empty cell is not blank here: .partners-grid
       paints --c-border and the cards paint --c-paper over it, so the gap IS the
       hairline rule and a missing card shows as a solid border-coloured block.
       Reset to auto at the 640 breakpoint, where the grid is one column and a
       two-row span would reopen the same hole. */
    .partner-card--tall { grid-row: span 2; }
    @media (max-width: 640px) {
      .partners-grid { grid-template-columns: 1fr; }
      .partner-card--tall { grid-row: auto; }
    }

    /* ─── FAQ ACCORDION ─── */
    .faq-item {
      border-bottom: 1px solid var(--c-border);
      padding: var(--s-3) 0;
    }
    /* Bebas: this is document structure (a question heading), not a component
       label. See the system note on h1,h2,h3 in shared.css. */
    .faq-q {
      font-family: 'Bebas Neue', Impact, sans-serif;
      font-size: var(--fs-22);
      font-weight: 600;
      color: var(--c-text);
      cursor: pointer;
      list-style: none;
      position: relative;
      padding-right: var(--s-5);
    }
    .faq-q::-webkit-details-marker { display: none; }
    .faq-q::after {
      content: '+';
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      color: var(--c-accent-text);
      font-weight: 400;
      font-size: var(--fs-22);
    }
    details[open] .faq-q::after { content: '−'; }
    .faq-a {
      font-size: var(--fs-15);
      font-weight: 300;
      color: var(--c-text);
      line-height: 1.75;
      margin-top: var(--s-2);
      max-width: 70ch;
    }`}></style>
