    <img src="/hero-sunrise-1920.jpg" width="1920" height="1080"
         alt="Sunrise over the Coachella Valley, mountains rising above a palm-lined city"
         loading="eager" fetchpriority="high" decoding="async">
  </picture>
  <div class="hero__inner">
    <span class="eyebrow">Coachella Valley · Est. 2025</span>
