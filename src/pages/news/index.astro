---
import { getCollection } from 'astro:content';
import NewsLayout from '../../layouts/NewsLayout.astro';
import { latestFromAicvNews, AICV_NEWS } from '../../lib/aicv-news';

const SITE = 'https://aicoachellavalley.org';

// The subscriber band: outbound cards from the aicv.news combined feed.
// Empty on any failure; the build still succeeds. See src/lib/aicv-news.ts.
const latest = await latestFromAicvNews(8);

const articles = (await getCollection('news'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const title = 'News — AI Coachella Valley';
const description =
  'Editorial coverage of AI in the Coachella Valley: what is happening across the nine cities, and why it matters here.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'AI Coachella Valley — News',
  description,
  url: `${SITE}/news`,
  isPartOf: { '@type': 'WebSite', name: 'AI Coachella Valley', url: SITE },
  publisher: { '@type': 'Organization', name: 'AI Coachella Valley', url: SITE },
};
---

<NewsLayout title={title} description={description} canonical={`${SITE}/news`} schema={schema}>
  {/* .page__inner (1080px), NOT .page__narrow (720px). 720 is a READING
      measure and belongs on the article; a card list with a 168px rail left
      only 470px for the headline, where a FOUR-word title wrapped to three
      lines at 56px. Measured, not guessed. This also gives .page__inner its
      first consumer — it had been dead in news.css since the file was
      written. */}
  <section class="page">
    <div class="page__inner">
      {/* The page-level eyebrow was REMOVED 2026-08-13. Every entry now
          carries a category label in the left margin using the same
          treatment, and running both put the identical styling on screen
          twice. The nav already marks this page as News. */}
      <h1 class="page__title">News</h1>
      <p class="page__lede">
        New writing is published at <a href={AICV_NEWS}>AICV News</a>. What follows is the
        archive of what AICV published here. Archive <a href="/news/rss.xml">RSS</a>.
      </p>

      {/* ── LATEST FROM AICV NEWS — outbound cards, /news only (brief 2026-09-08).
          Each card leaves this site. There are no .org routes behind them,
          nothing here enters .org's sitemap or RSS, and canonical stays at
          the origin. Empty band = feed unreachable at build time. ── */}
      {latest.length > 0 && (
        <section class="news-band" aria-labelledby="band-title">
          <h2 id="band-title" class="news-band__title">Latest from AICV News</h2>
          <ul class="news-list">
            {latest.map((it) => (
              <li class="news-item news-item--out">
                <span class="news-item__cat">{it.type}</span>
                <span class="news-item__date">{fmt(it.date)}</span>
                <h3 class="news-item__title">
                  <a href={it.link} rel="noopener">{it.title} <span class="news-item__out" aria-hidden="true">→</span></a>
                </h3>
                <p class="news-item__desc">{it.description}</p>
              </li>
            ))}
          </ul>
          <p class="news-band__more"><a href={AICV_NEWS}>All of AICV News →</a></p>
        </section>
      )}

      <h2 class="news-band__title news-band__title--archive">From the AICV archive</h2>

      {
        articles.length === 0 ? (
          <p class="news-item__desc" style="margin-top:var(--s-8)">
            No articles published yet.
          </p>
        ) : (
          <ul class="news-list">
            {articles.map((a) => (
              <li class="news-item">
                {/* FIRST in source order. Grid puts it in the left margin on
                    desktop; on mobile the single-column rule lets it stack
                    above the date with no `order:` override needed. */}
                <span class="news-item__cat">{a.data.category}</span>
                <span class="news-item__date">{fmt(a.data.date)}</span>
                <h2 class="news-item__title">
                  <a href={`/news/${a.id}`}>{a.data.title}</a>
                </h2>
                <p class="news-item__desc">{a.data.description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</NewsLayout>
