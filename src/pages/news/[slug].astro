---
import { getCollection, render } from 'astro:content';
import NewsLayout from '../../layouts/NewsLayout.astro';
import { person } from '../../data/people';

const SITE = 'https://aicoachellavalley.org';

export async function getStaticPaths() {
  const articles = await getCollection('news');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// article.data.author is a KEY into src/data/people.ts, not a display name.
const author = person(article.data.author);

const url = `${SITE}/news/${article.id}`;
const published = article.data.date.toISOString();
const modified = (article.data.updated ?? article.data.date).toISOString();

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

// ════════════════════════════════════════════════════════════════════════════
// @graph, not a bare NewsArticle. Changed 2026-08-12, DELIBERATELY WHILE
// /news IS EMPTY — one placeholder, zero real articles. An article page can
// carry more than one entity (a NewsArticle and, where the frontmatter has
// one, a FAQPage), and a bare object has room for exactly one. Making the
// shape conditional on whether `faq` exists would have meant two different
// JSON-LD shapes across the surface; moving to @graph now costs nothing and
// costs progressively more after the 32-file port lands.
//
// The FAQPage is generated from `article.data.faq` — the SAME array the
// visible section will render from when it lands. One source, so there is no
// mirror to drift and no guard to write. See src/content.config.ts.
// ════════════════════════════════════════════════════════════════════════════
const articleId = `${url}#article`;

const articleNode = {
  '@type': 'NewsArticle',
  '@id': articleId,
  headline: article.data.title,
  description: article.data.description,
  datePublished: published,
  dateModified: modified,
  // A REFERENCE, not a copy. Until 2026-08-10 this emitted an anonymous
  // { '@type': 'Person', name: '…' } with no @id, so to a machine the article's
  // author and the site's founder were two unrelated people who shared a name.
  // The Person is DEFINED once, on /author/sat-singh; everything else points
  // at that @id.
  author: { '@id': author.id },
  publisher: {
    '@type': 'Organization',
    name: 'AI Coachella Valley',
    url: SITE,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  keywords: article.data.tags.join(', '),
  isAccessibleForFree: true,
  areaServed: {
    '@type': 'Place',
    name: 'Coachella Valley, California',
  },
  ...(article.data.image ? { image: `${SITE}${article.data.image.src}` } : {}),
};

// Emitted ONLY when the frontmatter carries questions. The port is blog 20/20
// but signal 2/12 — ten pieces have no FAQ, and an empty FAQPage node asserting
// nothing is worse than no node.
const faqNode = article.data.faq?.length
  ? [
      {
        '@type': 'FAQPage',
        '@id': `${url}#faq`,
        mainEntityOfPage: { '@type': 'WebPage', '@id': url },
        about: { '@id': articleId },
        mainEntity: article.data.faq.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      },
    ]
  : [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [articleNode, ...faqNode],
};
---

<NewsLayout
  title={`${article.data.title} — AI Coachella Valley`}
  description={article.data.description}
  canonical={url}
  schema={schema}
  ogType="article"
  publishedTime={published}
  {/* Straight through from frontmatter — the ONE source. Flip `draft: false`
      and the noindex disappears on the next build with nothing to remember. */}
  draft={article.data.draft}
>
  <article class="page">
    <div class="page__narrow">
      <a href="/news" class="backlink">← News</a>

      <header class="article__header" style="margin-top:var(--s-5)">
        <p class="article__meta">
          {/* Relative path, not author.url — that is the ABSOLUTE form JSON-LD
              needs. Every internal link on this site is relative, and an
              absolute one sends local-preview clicks to production. */}
          {fmt(article.data.date)} · <a href={`/author/${author.slug}`} rel="author">{author.name}</a>
        </p>
        <h1 class="article__title">{article.data.title}</h1>
        {/* ⚠ THIS ELEMENT USED TO RENDER `description`, unconditionally. It now
            renders `standfirst` and is OMITTED ENTIRELY when there is none —
            no empty <p>, and deliberately NO FALLBACK to description.
            A deck and a meta description are different claims: 13 of the 20
            ported pieces that carry a standfirst say something their
            description does not, so falling back would put the wrong sentence
            under the headline rather than no sentence.
            Consequence, accepted: a piece with no standfirst now shows the
            headline followed directly by the body. */}
        {article.data.standfirst && (
          <p class="article__standfirst">{article.data.standfirst}</p>
        )}
      </header>

      <div class="article__body">
        <Content />
      </div>

      <footer class="article__footer">
        <ul class="tags">
          {article.data.tags.map((t) => <li class="tag">{t}</li>)}
        </ul>
      </footer>
    </div>
  </article>
</NewsLayout>
