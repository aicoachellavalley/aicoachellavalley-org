---
import Footer from '../components/Footer.astro';

// ════════════════════════════════════════════════════════════════════════════
// /404 — converted from public/404.html 2026-08-31 so it can use the shared
// Footer component. It is the FIRST of the four hand-written pages to move;
// partner, philanthropy and pledge are deliberately untouched.
//
// ⚠ THE <style> BLOCK BELOW MUST KEEP `is:inline`. This is the trap documented
// at length in index.astro and it applies verbatim here: a PLAIN <style> in an
// Astro page gets SCOPED, every rule stops matching this hand-written markup,
// and the page renders unstyled — a failure that looks like a CSS bug and is
// really a conversion bug. `is:global` is the other wrong answer: it is not
// scoped but Astro EXTRACTS it to /_astro/*.css, adding a request. `is:inline`
// opts out of all processing and ships the CSS exactly as authored.
//
// ⚠ shared.css STAYS A <link>, NOT A ?raw IMPORT. index.astro and events.astro
// inline it because they are landing-weight pages where a second request costs
// something. This page keeps the <link> it already had, so CSS delivery is
// byte-for-byte unchanged by the conversion and gate 6 sees exactly what it saw
// before. Changing the delivery mechanism is a separate decision from changing
// the file's location.
//
// ⚠ THE OUTPUT PATH IS LOAD-BEARING. Cloudflare Pages serves the build root's
// 404.html for any unmatched path. Astro emits src/pages/404.astro to
// dist/404.html under `build.format: 'file'`, which is the same artifact the
// static file produced — that is the whole reason this conversion is safe. If
// the build ever starts emitting dist/404/index.html instead, unmatched paths
// silently stop being 404s. Verify the emitted filename, not just the gates.
// ════════════════════════════════════════════════════════════════════════════
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Favicon — the .nav__mark treatment (volt tile, dark serif "AI"), exported
       2026-08-05. INTERIM: this is the CURRENT mark, not the AiCV/sun wordmark,
       which does not exist as artwork yet. See STATE.md. -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#081C15">
  <title>Page Not Found — AI Coachella Valley</title>
  <meta name="description" content="The page you're looking for doesn't exist. Return to the AI Coachella Valley homepage.">
  <meta name="robots" content="noindex, follow">
  <link rel="canonical" href="https://aicoachellavalley.org/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=EB+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">

    <!-- SITE CHROME — reset, nav, footer, tokens. ONE source: public/styles/shared.css.
       These four pages are hand-written HTML shipped byte-for-byte and can import
       nothing, so they LINK it. They already link Google Fonts, so this is not a new
       mechanism, and none of them is the landing page. Page-specific CSS stays inline
       below. Gate 6 fails the build if this page re-declares anything shared. -->
  <link rel="stylesheet" href="/styles/shared.css">
  <style is:inline>

    /* ════════════════════════════════════════
       TYPOGRAPHY UTILITIES
    ════════════════════════════════════════ */
    .eyebrow {
      display: block;
      font-size: var(--fs-10);
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--c-accent-text);
      margin-bottom: var(--s-2);
    }

    /* ════════════════════════════════════════
       BUTTONS
    ════════════════════════════════════════ */
    .btn {
      display: inline-block;
      font-family: 'DM Sans', sans-serif;
      font-size: var(--fs-13);
      font-weight: 500;
      letter-spacing: 0.03em;
      text-decoration: none;
      padding: 13px 28px;
      border: none;
      cursor: pointer;
      transition: background 0.15s, transform 0.1s;
      line-height: 1;
    }
    .btn:hover { transform: translateY(-1px); }

    .btn--primary { background: var(--c-accent-fill); color: var(--c-text); }
    .btn--primary:hover { background: var(--c-accent-fill-h); }
    .nav__cta {
      background: transparent !important;
      color: var(--c-on-ground-hi) !important;
      border: 1px solid var(--c-on-ground-hi) !important;
      padding: 6px 15px !important;   /* -1px absorbs the border: outer box unchanged */
      font-weight: 500 !important;
    }
    .nav__cta:hover { background: var(--c-accent-fill) !important; color: var(--c-text) !important; }
    .nav__drawer .drawer-cta {
      margin-top: 16px;
      background: var(--c-accent-fill);
      color: var(--c-text) !important;
      text-align: center;
      padding: 13px !important;
      border: none !important;
      font-weight: 500;
    }

    /* ════════════════════════════════════════
       HERO
    ════════════════════════════════════════ */
    .hero {
      background: var(--c-ground);
      padding: 100px var(--gutter) 90px;
      position: relative;
      overflow: hidden;
    }
    .hero__subhead {
      font-size: var(--fs-17);
      font-weight: 300;
      color: rgba(var(--c-paper-rgb),0.8);
      line-height: 1.6;
      max-width: 600px;
      margin-top: var(--s-3);
      margin-bottom: var(--s-3);
    }

    /* HERO — CREAM VARIANT */
    .hero--cream {
      background: var(--c-paper);
      border-bottom: 1px solid var(--c-border);
    }
    .hero--cream .h1         { color: var(--c-text); }
    .hero--cream .eyebrow    { color: var(--c-accent-text); opacity: 1; }
    .hero--cream .hero__subhead { color: var(--c-text); max-width: 640px; }
    .footer__desc {
      font-size: var(--fs-12);
      font-weight: 300;
      color: var(--c-on-ground-m);
      line-height: 1.7;
    }
    .footer__col-label {
      font-size: var(--fs-10);
      font-weight: 500;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--c-on-ground-m);
      margin-bottom: var(--s-2);
    }</style>
</head>
<body>

<!-- ── NAV ── -->
<nav class="nav">
  <div class="nav__inner">
    <a href="/" class="nav__logo">
      <div class="nav__mark">AI</div>
      <span class="nav__name">AI Coachella Valley</span>
    </a>
    <ul class="nav__links">
      <li><a href="/philanthropy" class="nav__cta">Philanthropy</a></li>
      <li><a href="/#programs">Programs</a></li>
      <li><a href="/events">Events</a></li>
      <li><a href="/news">News</a></li>
      <li><a href="/author/sat-singh">About</a></li>
    </ul>
    <button class="nav__hamburger" id="nav-toggle" aria-label="Open menu" onclick="this.classList.toggle('is-open');document.getElementById('nav-drawer').classList.toggle('is-open')">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="nav__drawer" id="nav-drawer">
  <a href="/philanthropy" class="drawer-cta" onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')">Philanthropy</a>
  <a href="/#programs" onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')">Programs</a>
  <a href="/events" onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')">Events</a>
  <a href="/news" onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')">News</a>
  <a href="/author/sat-singh" onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')">About</a>
</div>

<!-- ── NOT FOUND ── -->
<section class="hero hero--cream">
  <div class="hero__inner">
    <span class="eyebrow">404 · Page Not Found</span>
    <h1 class="h1">This page doesn't exist.</h1>
    <p class="hero__subhead">The URL you followed may be mistyped, moved, or never existed.</p>
    <a href="/" class="btn btn--primary">Back to Homepage</a>
  </div>
</section>

<!-- ── FOOTER ── -->
<Footer />

</body>
</html>
