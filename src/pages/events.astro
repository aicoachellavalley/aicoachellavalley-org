---
import sharedCss from '../../public/styles/shared.css?raw';
// ⚠ ?raw + set:html, NOT an Astro style-tag import. This block MUST stay is:inline:
// (that sentence deliberately avoids writing the literal tag — a bare mention of it
//  in a comment is what made an earlier parser swallow 7KB of frontmatter as CSS)
// `is:global` was tried and shipped the homepage with 0 bytes inline plus a
// render-blocking <link> — measured, on the landing page. `?raw` keeps assembly
// ours, so the CSS is inlined verbatim and still has ONE source (shared.css).
import data from '../data/events.json';

// ════════════════════════════════════════════════════════════════════════════
// /events — converted from public/events.html 2026-08-11. The <head>, the nav,
// the drawer, the footer and the whole 15KB <style> block are carried over
// VERBATIM; only three things changed, and all three are additive:
//
//   1. the hand-written EventSeries JSON-LD became a derived @graph
//   2. the Luma iframe gained an "Upcoming" heading
//   3. the record — SECTION 3 — is new
//
// WHY THIS IS AN ASTRO PAGE AND NOT STATIC HTML:
// index.astro's JSON-LD is `is:inline`, which Astro does NOT interpolate — that
// limitation is the reason scripts/prepare-feeds.mjs carries an identity guard
// instead of importing people.json. This page uses `set:html` (the pattern
// proven in NewsLayout) so all 42 events are genuinely DERIVED. The <style>
// stays `is:inline` for the opposite reason: `is:global` would externalise it
// to /_astro/*.css and change how the page loads.
//
// NOT built on NewsLayout, deliberately. Its footer says "Preparing the
// Coachella Valley for the future of work…" and links the SunshineFM
// newsletter; this page says "Building the Coachella Valley's AI Startup
// Ecosystem." and links News RSS. Adopting the layout would silently rewrite
// three pieces of footer copy on a page whose chrome is supposed to be
// unchanged.
// ════════════════════════════════════════════════════════════════════════════

const SITE = 'https://aicoachellavalley.org';

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// Events ascending within a series; series ordered by FIRST event date,
// descending. Ruled 2026-08-11: "most recent first" is ambiguous here because
// AI Weekly (Wednesdays) and Launchpad (Saturdays) ran CONCURRENTLY through
// summer 2025. Ordering by first date reverses cleanly into the actual arc —
// coffee meetups, community forum, hands-on building, structured curriculum,
// agents, funded monthly lab.
const sorted = [...data.events].sort((a, b) => a.date.localeCompare(b.date));
const names: string[] = [];
for (const e of sorted) if (!names.includes(e.series)) names.push(e.series);
const series = names
  .map((name) => {
    const events = sorted.filter((e) => e.series === name);
    return { name, slug: slug(name), events, first: events[0].date };
  })
  .sort((a, b) => b.first.localeCompare(a.first));

// DERIVED. Nothing on this page types a count.
const total = data.events.length;
const earliest = sorted[0].date;
const latest = sorted[sorted.length - 1].date;

const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const VENUE_ID = `${SITE}/events#venue-erc`;
const ORG_ID = `${SITE}/#organization`;

// ONE Place node, referenced by @id from all 42 events — never repeated.
// The six EventSeries nodes carry NO description: the only supportable cadence
// claim on this page is Idea Labs' "monthly", and that already lives in the
// Idea Labs synopsis where it is sourced. Putting it on a series node too would
// duplicate a claim, and putting it on the others would restate the one the
// record disproves. prepare-feeds.mjs asserts "monthly" appears exactly once.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Place',
      '@id': VENUE_ID,
      name: data.venue.name,
      address: { '@type': 'PostalAddress', ...data.venue.address },
    },
    ...series.map((s) => ({
      '@type': 'EventSeries',
      '@id': `${SITE}/events#series-${s.slug}`,
      name: s.name,
      url: `${SITE}/events`,
      organizer: { '@id': ORG_ID },
    })),
    ...sorted.map((e) => ({
      '@type': 'Event',
      '@id': `${SITE}/events#event-${e.date}`,
      name: e.title,
      // start_at is OPTIONAL and absent from all 42 — the hand-assembled rows
      // carry no times. A future row that has one emits a full datetime here
      // with no migration and no reformat of the existing 42.
      startDate: (e as { start_at?: string }).start_at ?? e.date,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      description: e.synopsis,
      location: { '@id': VENUE_ID },
      superEvent: { '@id': `${SITE}/events#series-${slug(e.series)}` },
      organizer: { '@id': ORG_ID },
    })),
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Favicon — the .nav__mark treatment (volt tile, dark serif "AI"), exported
       2026-08-05. INTERIM: this is the CURRENT mark, not the AiCV/sun wordmark,
       which does not exist as artwork yet. See STATE.md. -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#081C15">
  <title>AI Events in the Coachella Valley — AI Coachella Valley</title>
  <meta name="description" content="AI events in the Coachella Valley — workshops, meetups, boot camps, and conferences. Hands-on AI for founders, builders, and small business owners, held at the Entrepreneurial Resource Center (ERC) in Palm Desert.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://aicoachellavalley.org/events">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=EB+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">

  <meta name="last-modified" content={data.assembled_at}>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="AI Coachella Valley">
  <meta property="og:title" content="AI Events in the Coachella Valley — AI Coachella Valley">
  <meta property="og:description" content="Workshops, meetups, boot camps, and conferences — hands-on AI for founders, builders, and small business owners in the Coachella Valley.">
  <meta property="og:url" content="https://aicoachellavalley.org/events">
  <meta property="og:image" content="https://aicoachellavalley.org/idea-labs-cover.png">
  <meta property="og:locale" content="en_US">

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="AI Events in the Coachella Valley — AI Coachella Valley">
  <meta name="twitter:description" content="Workshops, meetups, boot camps, and conferences — hands-on AI for founders, builders, and small business owners in the Coachella Valley.">
  <meta name="twitter:image" content="https://aicoachellavalley.org/idea-labs-cover.png">

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <style is:inline set:html={sharedCss + `
    .nav__links a.is-active { color: var(--c-on-ground-hi); font-weight: 500; }
    .nav__cta {
      background: transparent !important;
      color: var(--c-on-ground-hi) !important;
      border: 1px solid var(--c-on-ground-hi) !important;
      padding: 6px 15px !important;   /* -1px absorbs the border: outer box unchanged */
      font-weight: 500 !important;
    }
    .nav__cta:hover { background: var(--c-accent-fill) !important; color: var(--c-text) !important; }
    .nav__drawer .drawer-cta {
      margin-top: 16px;
      background: var(--c-accent-fill);
      color: var(--c-text) !important;
      text-align: center;
      padding: 13px !important;
      border: none !important;
      font-weight: 500;
    }

    /* ════════════════════════════════════════
       HERO
    ════════════════════════════════════════ */
    .hero {
      background: var(--c-ground);
      padding: 56px var(--gutter) 44px;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background-image: repeating-linear-gradient(
        -45deg,
        transparent, transparent 40px,
        rgba(255,255,255,0.011) 40px, rgba(255,255,255,0.011) 41px
      );
      pointer-events: none;
    }
    .hero__subhead {
      font-size: var(--fs-17);
      font-weight: 300;
      color: rgba(var(--c-paper-rgb),0.8);
      line-height: 1.6;
      max-width: 600px;
      margin-top: var(--s-2);
      margin-bottom: var(--s-2);
    }@keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .hero .h1        { animation: fadeUp 0.55s ease both 0.2s; }
    .hero__subhead   { animation: fadeUp 0.55s ease both 0.28s; }

    /* ════════════════════════════════════════
       HERO — CREAM VARIANT
    ════════════════════════════════════════ */
    .hero--cream {
      background: var(--c-paper);
      border-bottom: 1px solid var(--c-border);
    }
    .hero--cream::before         { display: none; }
    .hero--cream .h1             { color: var(--c-text); }

    /* ════════════════════════════════════════
       HERO — CREAM TEXT OVERRIDES
    ════════════════════════════════════════ */
    .hero--cream .hero__subhead { color: var(--c-text); max-width: 640px; }
    .footer__desc {
      font-size: var(--fs-12);
      font-weight: 300;
      color: var(--c-on-ground-m);
      line-height: 1.7;
    }
    .footer__col-label {
      font-size: var(--fs-10);
      font-weight: 500;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--c-on-ground-m);
      margin-bottom: var(--s-2);
    }

    /* ════════════════════════════════════════
       CALENDAR BAND
    ════════════════════════════════════════ */
    .calendar-band {
      background: var(--c-paper);
      padding: var(--s-8) var(--gutter) var(--s-10);
    }
    .calendar-band__inner {
      max-width: 900px;
      margin: 0 auto;
    }
    .calendar-band__inner iframe {
      display: block;
      width: 100%;
      border: 1px solid var(--c-border);
      border-radius: 12px;
    }
      /* ════════════════════════════════════════ THE RECORD ════════════════════════════════════════ */
      .calendar-band__title {font-size: var(--fs-22); color: var(--c-text); letter-spacing: -0.01em; margin-bottom: var(--s-3);}
      .record {background: var(--c-surface); border-top: 1px solid var(--c-border); padding: var(--s-10) var(--gutter) var(--s-14);}
      .record__inner {max-width: 760px; margin: 0 auto;}
      .record__title {font-size: var(--fs-h2); color: var(--c-text); letter-spacing: -0.02em; line-height: 1.1;}
      .record__lede {font-size: var(--fs-17); font-weight: 300; color: var(--c-text-l); line-height: 1.6; margin-top: var(--s-2); padding-bottom: var(--s-6); border-bottom: 1px solid var(--c-border);}
      .series {margin-top: var(--s-8);}
      .series__head {display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-2); padding-bottom: var(--s-2); border-bottom: 1px solid var(--c-border);}
      .series__name {
      /* ⚠ EB GARAMOND ON PURPOSE — it went Bebas by INHERITANCE in pass 2 (it is an
         <h3> and declared no face of its own) and that was backwards. This is a
         LABEL over a session list, paired with a "N SESSIONS" count, and in Bebas
         it rendered louder than the session titles beneath it — the label shouting
         over the thing it labels.
         .record__title and .calendar-band__title on this page stay Bebas: those
         are the page's own structure. See the rule in shared.css. */
      font-family: 'EB Garamond', Georgia, serif;
      font-weight: 700;
      line-height: 1.12;
font-size: var(--fs-22); color: var(--c-text); letter-spacing: -0.01em;}
      .series__count {font-size: var(--fs-12); text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-text-l); white-space: nowrap;}
      .event-list {list-style: none; margin: 0; padding: 0;}
      .event-item {padding: var(--s-3) 0; border-bottom: 1px solid var(--c-border-l);}
      .event-item:last-child {border-bottom: none;}
      .event-item__date {display: block; font-size: var(--fs-12); text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-text-l);}
      .event-item__title {font-size: var(--fs-17); color: var(--c-text); margin-top: var(--s-1); font-weight: 600;}
      .event-item__synopsis {font-size: var(--fs-15); font-weight: 300; line-height: 1.65; color: var(--c-text-l); margin-top: var(--s-1);}@media (max-width: 640px) {
        .record {padding: var(--s-8) var(--gutter) var(--s-10);}
        .series__head {flex-direction: column; align-items: flex-start; gap: var(--s-1);}
    }`}></style>
</head>
<body>

<!-- ── NAV ── -->
<nav class="nav">
  <div class="nav__inner">
    <a href="/" class="nav__logo">
      <div class="nav__mark">AI</div>
      <span class="nav__name">AI Coachella Valley</span>
    </a>
    <ul class="nav__links">
      <li><a href="/philanthropy" class="nav__cta">Philanthropy</a></li>
      <li><a href="/#programs">Programs</a></li>
      <li><a href="/events" class="is-active">Events</a></li>
      <li><a href="/news">News</a></li>
      <li><a href="/#founder">About</a></li>
      <li><a href="https://aicoachellavalley.com">Intelligence Network ↗</a></li>
    </ul>
    <button class="nav__hamburger" id="nav-toggle" aria-label="Open menu" onclick="this.classList.toggle('is-open');document.getElementById('nav-drawer').classList.toggle('is-open')">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="nav__drawer" id="nav-drawer">
  <a href="/philanthropy" class="drawer-cta" onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')">Philanthropy</a>
  <a href="/#programs" onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')">Programs</a>
  <a href="/events" onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')">Events</a>
  <a href="/news" onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')">News</a>
  <a href="/#founder" onclick="document.getElementById('nav-drawer').classList.remove('is-open');document.getElementById('nav-toggle').classList.remove('is-open')">About</a>
  <a href="https://aicoachellavalley.com">Intelligence Network ↗</a>
</div>

<!-- SECTION 1 — HERO -->
<section class="hero hero--cream">
  <div class="hero__inner">
    <h1 class="h1">AI events in the Coachella Valley.</h1>
    <p class="hero__subhead">Workshops, meetups, boot camps, and conferences — hands-on AI for founders, builders, and small business owners. Hosted by AI Coachella Valley at the Entrepreneurial Resource Center (ERC) in Palm Desert.</p>
  </div>
</section>

<!-- SECTION 2 — CALENDAR -->
<section class="calendar-band">
  <div class="calendar-band__inner">
    <h2 class="calendar-band__title">Upcoming</h2>
    <iframe src="https://luma.com/embed/calendar/cal-123s6rDFxeKQjJd/events?lt=light" width="100%" height="560" frameborder="0" style="border:none; display:block;" allow="fullscreen; payment" aria-hidden="false" tabindex="0"></iframe>
  </div>
</section>

<!-- SECTION 3 — THE RECORD -->
<section class="record">
  <div class="record__inner">
    <h2 class="record__title">The record.</h2>
    <p class="record__lede">
      {total} sessions, {fmt(earliest)} to {fmt(latest)} — every one of them at the {data.venue.display}.
    </p>
    {series.map((s) => (
      <section class="series" id={`series-${s.slug}`}>
        <header class="series__head">
          <h3 class="series__name">{s.name}</h3>
          <span class="series__count">{s.events.length} {s.events.length === 1 ? 'session' : 'sessions'}</span>
        </header>
        <ul class="event-list">
          {s.events.map((e) => (
            <li class="event-item">
              <span class="event-item__date">{fmt(e.date)}</span>
              {e.title !== s.name && <h4 class="event-item__title">{e.title}</h4>}
              <p class="event-item__synopsis">{e.synopsis}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>

<!-- ── FOOTER ── -->
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <div>
        <div class="footer__mark">AICV · aicoachellavalley.org</div>
        <div class="footer__name">AICV</div>
        <p class="footer__desc">Preparing the Coachella Valley for the AI economy.<br><br>A fiscally sponsored project of Desert Community Foundation.</p>
      </div>
      <div>
        <div class="footer__col-label">Navigate</div>
        <ul class="footer__links">
          <li><a href="/philanthropy">Philanthropy</a></li>
          <li><a href="/#programs">Programs</a></li>
          <li><a href="/events">Events</a></li>
          <li><a href="/news">News</a></li>
          <li><a href="/pledge">Responsible AI Pledge</a></li>
          <li><a href="/#founder">About AICV</a></li>
          <li><a href="/author/sat-singh">Founder</a></li>
        </ul>
      </div>
      <div>
        <div class="footer__col-label">Contact</div>
        <ul class="footer__links">
          <li><a href="mailto:sat@aicv.co">sat@aicv.co</a></li>
          <li><a href="https://aicoachellavalley.com">Intelligence Network (.com) ↗</a></li>
          <li><a href="/news/rss.xml">News RSS ↗</a></li>
          <li><a href="https://x.com/CoachellaAI">@CoachellaAI ↗</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <div class="footer__copy">© 2026 AI Coachella Valley</div>
      <div class="footer__tagline">AI training and in-person events across the valley since 2025.</div>
    </div>
  </div>
</footer>

</body>
</html>
