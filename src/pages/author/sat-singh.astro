---
import NewsLayout from '../../layouts/NewsLayout.astro';
import { getCollection } from 'astro:content';
import { person } from '../../data/people';

// ════════════════════════════════════════════════════════════════════════════
// /author/sat-singh — the destination article bylines resolve to.
//
// Built 2026-08-10 BEFORE the SunshineFM port so 32 ported pieces get a byline
// that lands somewhere, rather than being reprocessed later.
//
// This page carries the CANONICAL Person definition. index.astro's founder node
// and every article's `author` reference the same @id; nothing else defines it.
//
// The prose is lifted VERBATIM from the homepage founder section — the two
// paragraphs that are actually about Sat. The other two there are about AICV
// (mission, org track record) and stay on the homepage. No new claims are made
// on this page.
//
// navActive={null}: this is not /news. Without it the layout would highlight
// "News" in the nav as though this were the news index.
// ════════════════════════════════════════════════════════════════════════════

const SITE = 'https://aicoachellavalley.org';
const p = person('sat-singh');

const articles = (await getCollection('news'))
  .filter((a) => !a.data.draft && a.data.author === p.slug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const title = `${p.name} — AI Coachella Valley`;
const description =
  'Sat Singh is the founder of AI Coachella Valley. He covers the AI beat for the Inland Empire and writes about AI, business, media, and culture in the Coachella Valley.';

// ProfilePage, not AboutPage: AboutPage describes the ORGANISATION behind a
// site; ProfilePage is the type for a person profile, and it is the one search
// engines document for author pages, with mainEntity being the Person.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${p.url}#profilepage`,
  url: p.url,
  name: p.name,
  isPartOf: { '@type': 'WebSite', '@id': `${SITE}/#website` },
  mainEntity: {
    '@type': 'Person',
    '@id': p.id,
    name: p.name,
    url: p.url,
    jobTitle: p.jobTitle,
    description: p.description,
    image: p.image,
    sameAs: p.sameAs,
    worksFor: { '@id': `${SITE}/#organization` },
    // This page carries the CANONICAL Person, so it must emit every claim in
    // people.json — not a subset. index.astro's founder node had these and this
    // did not, which would have made the two disagree on the same @id.
    ...(p.hasOccupation ? { hasOccupation: p.hasOccupation } : {}),
    ...(p.subjectOf ? { subjectOf: p.subjectOf } : {}),
  },
};
---

<NewsLayout
  title={title}
  description={description}
  canonical={p.url}
  schema={schema}
  ogType="profile"
  navActive={null}
>
  <section class="page">
    <div class="page__narrow">
      <span class="eyebrow">Author</span>
      <h1 class="page__title">{p.name}</h1>
      <p class="page__lede">{p.jobTitle}, AI Coachella Valley</p>

      {/* ⚠ NO PORTRAIT HERE, AND `image` IN people.json IS CORRECT — the two
          are SUPPOSED to disagree, so do not "fix" this by re-adding an img.

          The removed asset was /sat-tedx.png: a 1024x1024 JPEG (mis-named
          .png) of a TEDx stage, rendering 640px square on a 720px measure —
          a stage shot doing duty as a portrait. No portrait crop of Sat
          exists in public/. This page's job is to answer "who wrote this",
          and a name, a role, a bio and a list of pieces answers it.

          people.json KEEPS `image`, and the Person JSON-LD keeps emitting it:
          schema.org Person.image is a legitimate property, and that node is
          about to anchor 132 nodes from the SunshineFM side. A machine-
          readable value with no visible twin is normally the defect this repo
          hunts; here it is the correct outcome, because the consumers differ.

          The removal also closes a CLS defect: the img declared 960x540
          against a 1024x1024 asset, so the browser reserved 640x360 and then
          reflowed to 640x640 — a ~280px shift on every load.

          The TEDx link is NOT lost. It survives twice on this page: in the
          bio prose and in "Elsewhere", which is its natural home. */}

      <div class="article__body">
        <p>
          Sat Singh covers the AI beat for the Inland Empire at InformedIE. He writes about AI,
          business, media, and culture in the Coachella Valley at <a href="/news">AICV News</a>, and
          hosts a daily talk show and weekend radio for Palm Springs Coachella at
          <a href="https://sunshine.fm/" target="_blank" rel="noopener">SunshineFM</a>.
        </p>
        <p>
          AICV was founded by Sat Singh — a
          <a href="https://www.youtube.com/watch?v=oYG2kFC2_D4" target="_blank" rel="noopener"
            >TEDx Rancho Mirage speaker</a
          >, community educator, and technology entrepreneur based in the Coachella Valley. He
          previously co-founded a gaming studio acqui-hired by King.com.
        </p>
      </div>

      <div class="author-elsewhere">
        <div class="author-elsewhere__label">Elsewhere</div>
        <ul class="author-elsewhere__list">
          <li><a href="https://sunshine.fm/" target="_blank" rel="noopener">SunshineFM ↗</a></li>
          <li><a href="https://x.com/CoachellaAI" target="_blank" rel="noopener">@CoachellaAI ↗</a></li>
          <li>
            <a href="https://www.youtube.com/watch?v=oYG2kFC2_D4" target="_blank" rel="noopener"
              >TEDx Rancho Mirage ↗</a
            >
          </li>
        </ul>
      </div>

      {
        articles.length > 0 && (
          <div class="author-writing">
            <h2 class="h2">Writing</h2>
            <ul class="news-list">
              {articles.map((a) => (
                <li class="news-item">
                  {/* The SAME component as /news, so it needs the same first
                      child. Without it the card's 168px rail rendered EMPTY
                      and squeezed the headline to 470px — the identical
                      defect fixed on the index, surviving here because this
                      list was never looked at after the rail landed. */}
                  <span class="news-item__cat">{a.data.category}</span>
                  <span class="news-item__date">{fmt(a.data.date)}</span>
                  <h3 class="news-item__title">
                    <a href={`/news/${a.id}`}>{a.data.title}</a>
                  </h3>
                  <p class="news-item__desc">{a.data.description}</p>
                </li>
              ))}
            </ul>
            <a href="/news" class="news-all">All news →</a>
          </div>
        )
      }
    </div>
  </section>
</NewsLayout>
