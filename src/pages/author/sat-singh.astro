---
import NewsLayout from '../../layouts/NewsLayout.astro';
import { getCollection } from 'astro:content';
import { person } from '../../data/people';
import eventsData from '../../data/events.json';

// ════════════════════════════════════════════════════════════════════════════
// /author/sat-singh — the destination article bylines resolve to.
//
// Built 2026-08-10 BEFORE the SunshineFM port so 32 ported pieces get a byline
// that lands somewhere, rather than being reprocessed later.
//
// This page carries the CANONICAL Person definition. index.astro's founder node
// and every article's `author` reference the same @id; nothing else defines it.
//
// The prose is lifted VERBATIM from the homepage founder section — the two
// paragraphs that are actually about Sat. The other two there are about AICV
// (mission, org track record) and stay on the homepage. No new claims are made
// on this page.
//
// navActive={null}: this is not /news. Without it the layout would highlight
// "News" in the nav as though this were the news index.
// ════════════════════════════════════════════════════════════════════════════

const SITE = 'https://aicoachellavalley.org';
const p = person('sat-singh');

// DERIVED, never typed — the same rule the homepage and /events follow. Both
// numbers come from src/data/events.json, so the bio cannot drift from the
// record it describes. seriesCount counts DISTINCT series values, which is the
// same derivation /events uses to build its six section headings.
const sessionCount = eventsData.events.length;
const seriesCount = new Set(eventsData.events.map((e) => e.series)).size;

const articles = (await getCollection('news'))
  .filter((a) => !a.data.draft && a.data.author === p.slug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const title = `${p.name} — AI Coachella Valley`;
const description =
  'Sat Singh is the founder of AI Coachella Valley. He covers the AI beat for the Inland Empire and writes about AI, business, media, and culture in the Coachella Valley.';

// ProfilePage, not AboutPage: AboutPage describes the ORGANISATION behind a
// site; ProfilePage is the type for a person profile, and it is the one search
// engines document for author pages, with mainEntity being the Person.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${p.url}#profilepage`,
  url: p.url,
  name: p.name,
  isPartOf: { '@type': 'WebSite', '@id': `${SITE}/#website` },
  mainEntity: {
    '@type': 'Person',
    '@id': p.id,
    name: p.name,
    url: p.url,
    jobTitle: p.jobTitle,
    description: p.description,
    image: p.image,
    sameAs: p.sameAs,
    worksFor: { '@id': `${SITE}/#organization` },
    // This page carries the CANONICAL Person, so it must emit every claim in
    // people.json — not a subset. index.astro's founder node had these and this
    // did not, which would have made the two disagree on the same @id.
    ...(p.hasOccupation ? { hasOccupation: p.hasOccupation } : {}),
    ...(p.subjectOf ? { subjectOf: p.subjectOf } : {}),
  },
};
---

<NewsLayout
  title={title}
  description={description}
  canonical={p.url}
  schema={schema}
  ogType="profile"
  navActive={null}
>
  <section class="page">
    <div class="page__narrow">
      <span class="eyebrow">About</span>
      <h1 class="page__title">{p.name}</h1>
      <p class="page__lede">{p.jobTitle}, AI Coachella Valley</p>

      {/* ⚠ NO PORTRAIT HERE, AND `image` IN people.json IS CORRECT — the two
          are SUPPOSED to disagree, so do not "fix" this by re-adding an img.

          The removed asset was /sat-tedx.png: a 1024x1024 JPEG (mis-named
          .png) of a TEDx stage, rendering 640px square on a 720px measure —
          a stage shot doing duty as a portrait. No portrait crop of Sat
          exists in public/. This page's job is to answer "who wrote this",
          and a name, a role, a bio and a list of pieces answers it.

          people.json KEEPS `image`, and the Person JSON-LD keeps emitting it:
          schema.org Person.image is a legitimate property, and that node is
          about to anchor 132 nodes from the SunshineFM side. A machine-
          readable value with no visible twin is normally the defect this repo
          hunts; here it is the correct outcome, because the consumers differ.

          The removal also closes a CLS defect: the img declared 960x540
          against a 1024x1024 asset, so the browser reserved 640x360 and then
          reflowed to 640x640 — a ~280px shift on every load.

          The TEDx link is NOT lost. It survives twice on this page: in the
          bio prose and in "Elsewhere", which is its natural home. */}

      {/* ⚠ OUTSIDE .article__body ON PURPOSE. news.css carries `.article__body h2`
          at specificity (0,1,1), which beats the `.h2` class at (0,1,0) and would
          replace its margin with `1.1em 0 0.45em` — the in-article heading rhythm,
          not the section-label one this is. Moving it inside that div changes how
          it sits without changing a single character of markup. */}
      <h2 class="h2">How this started</h2>

      <div class="article__body">
        {/* ⚠ NO INFORMEDIE HERE. This sentence opened "Sat Singh covers the AI beat
            for the Inland Empire at InformedIE." Removed 2026-08-17 under the founder
            ruling of 2026-08-16: InformedIE gets its own domain and does not live on
            .org, in prose or in schema. The same sentence was removed from the Person
            node and people.json in 0ef39bc; this was the last mention on the property,
            and prose is where a reader actually sees it. Do not re-add when the domain
            launches — link to it from SunshineFM instead. */}
        {/* ⚠ THE ONE-LINE PARAGRAPHS ARE PACING, NOT ACCIDENTS. "For a while, he
            thought artificial intelligence might be the catalyst.", "Then ChatGPT
            arrived in November 2022.", "The concern was what would happen next.",
            "It never really took.", "In 2025, the writing became rooms." — each is
            its own beat and each stands alone deliberately. Do not merge them into
            the paragraphs around them to tidy the markup. */}
        <p>Sat Singh founded AI Coachella Valley in 2025, but the idea behind it had been forming for years.</p>
        <p>
          He has spent most of his life starting things — sometimes on his own, sometimes with
          partners, sometimes from inside larger companies. The industries changed, but the instinct
          was usually the same: see something that could exist, then try to make it real.
        </p>
        <p>
          After co-founding a gaming studio that was acqui-hired by King.com, Sat spent close to
          fifteen years wanting to build a founders' studio in the Coachella Valley — a physical
          place where people came to make things, not simply serve the people who came to visit.
        </p>
        <p>For a while, he thought artificial intelligence might be the catalyst.</p>
        <p>
          Between 2014 and 2016, he built and funded startups around natural language and machine
          learning, working with the early Alexa, Google Home and DeepMind era. After three years,
          the conclusion was fairly clear. The idea was ahead of the technology.
        </p>
        <p>Then ChatGPT arrived in November 2022.</p>
        <p>
          Having spent years around an earlier, underpowered version of the same promise, Sat
          recognized immediately that something had changed.
        </p>
        <p>
          His concern was not whether the Coachella Valley had access to AI. For once, everyone had
          access at the same time.
        </p>
        <p>The concern was what would happen next.</p>
        <p>
          The desert has often been late to adopting new technologies in meaningful ways — not
          because the tools are unavailable, but because institutions, businesses and communities
          take longer to understand how to use them. Sat did not want AI to follow the same pattern.
        </p>
        <p>
          So throughout 2023, he tried to convince local cities and regional organizations to
          approach AI collectively: learn together, experiment together and avoid falling behind one
          organization at a time.
        </p>
        <p>It never really took.</p>
        <p>
          In 2024, he changed tactics and started writing instead — documenting AI through the lens
          of the Coachella Valley and trying to make an unfamiliar technology useful and
          understandable locally.
        </p>
        <p>In 2025, the writing became rooms.</p>
        <p>
          Beginning that April, Sat started running hands-on AI workshops at the CSUSB Palm Desert
          Entrepreneurial Resource Center. Those sessions became AI Coachella Valley.
        </p>
        <p>
          Since then, AICV has run {sessionCount} sessions across {seriesCount} series, become an
          official affiliate of the ERC, launched
          <a href="https://coachella-valley.aitinkerers.org" target="_blank" rel="noopener"
            >AI Tinkerers Coachella Valley</a
          > — the region's chapter of the global AI builders' community — and begun The AI Beat,
          grant-funded regional reporting on how artificial intelligence is changing the Inland
          Empire.
        </p>
        <p>
          Sat spoke at
          <a href="https://www.youtube.com/watch?v=oYG2kFC2_D4" target="_blank" rel="noopener"
            >TEDx Rancho Mirage</a
          > in August 2025. He works from a resident office at the ERC in Palm Desert and a home
          studio in Rancho Mirage.
        </p>
        <p>
          The founders' studio is still the idea. A physical place in the desert where founders,
          builders and curious people come to make things.
        </p>
        <p>
          AI Coachella Valley is the work of making sure that, when that room finally exists, the
          region is ready for it.
        </p>
      </div>

      <div class="author-elsewhere">
        <div class="author-elsewhere__label">Elsewhere</div>
        <ul class="author-elsewhere__list">
          <li><a href="https://sunshine.fm/" target="_blank" rel="noopener">SunshineFM ↗</a></li>
          <li><a href="https://x.com/CoachellaAI" target="_blank" rel="noopener">@CoachellaAI ↗</a></li>
          <li>
            <a href="https://www.youtube.com/watch?v=oYG2kFC2_D4" target="_blank" rel="noopener"
              >TEDx Rancho Mirage ↗</a
            >
          </li>
        </ul>
      </div>

      {
        articles.length > 0 && (
          <div class="author-writing">
            <h2 class="h2">Writing</h2>
            <ul class="news-list">
              {articles.map((a) => (
                <li class="news-item">
                  {/* The SAME component as /news, so it needs the same first
                      child. Without it the card's 168px rail rendered EMPTY
                      and squeezed the headline to 470px — the identical
                      defect fixed on the index, surviving here because this
                      list was never looked at after the rail landed. */}
                  <span class="news-item__cat">{a.data.category}</span>
                  <span class="news-item__date">{fmt(a.data.date)}</span>
                  <h3 class="news-item__title">
                    <a href={`/news/${a.id}`}>{a.data.title}</a>
                  </h3>
                  <p class="news-item__desc">{a.data.description}</p>
                </li>
              ))}
            </ul>
            <a href="/news" class="news-all">All news →</a>
          </div>
        )
      }
    </div>
  </section>
</NewsLayout>
